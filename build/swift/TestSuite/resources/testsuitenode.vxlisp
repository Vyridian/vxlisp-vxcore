         :text "Test Suite")))
     (vx/web/html/div
      :nodes
       (vx/web/html/divchildlist
        (vx/web/html/div
         :nodes
          (vx/web/html/divchildlist
           (vx/web/html/p
            :text "Pass?")
           (vx/web/html/p
            :text "Package Name")
           (vx/web/html/p
            :text "Coverage")
           (vx/web/html/p
            :text "(type)")
           (vx/web/html/p
            :text "(const)")
           (vx/web/html/p
            :text "(func)")
           (vx/web/html/p
            :text ":doc")
           (vx/web/html/p
            :text ":bigospace")
           (vx/web/html/p
            :text ":bigotime")))
        (vx/web/html/div))))))